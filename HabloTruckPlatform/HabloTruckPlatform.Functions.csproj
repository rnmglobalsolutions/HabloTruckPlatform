<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.50.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="Ulid" Version="1.4.1" />
    <PackageReference Include="Stripe.net" Version="50.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HabloTruckPlatform.Application">
      <HintPath>..\HabloTruckPlatform.Application\bin\Debug\net10.0\HabloTruckPlatform.Application.dll</HintPath>
    </Reference>
    <Reference Include="HabloTruckPlatform.Domain">
      <HintPath>..\HabloTruckPlatform.Domain\bin\Debug\net10.0\HabloTruckPlatform.Domain.dll</HintPath>
    </Reference>
    <Reference Include="HabloTruckPlatform.Infrastructure">
      <HintPath>..\HabloTruckPlatform.Infrastructure\bin\Debug\net10.0\HabloTruckPlatform.Infrastructure.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
