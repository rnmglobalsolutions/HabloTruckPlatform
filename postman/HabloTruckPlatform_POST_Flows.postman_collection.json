              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_invoice_paid\",\n  \"object\": \"event\",\n  \"api_version\": \"2024-06-20\",\n  \"type\": \"invoice.paid\",\n  \"created\": 1770000000,\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"request\": {\n    \"id\": \"req_test\",\n    \"idempotency_key\": null\n  },\n  \"data\": {\n    \"object\": {\n      \"id\": \"{{invoiceId}}\",\n      \"object\": \"invoice\",\n      \"customer\": \"{{stripeCustomerId}}\",\n      \"subscription\": \"{{subscriptionId}}\",\n      \"lines\": {\n        \"data\": [\n          {\n            \"quantity\": 1,\n            \"price\": {\n              \"id\": \"price_ind_monthly\",\n              \"recurring\": {\n                \"interval\": \"month\"\n              }\n            },\n            \"period\": {\n              \"end\": 1772600000\n            }\n          }\n        ]\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
